---
import BaseLayout from '../../layouts/BaseLayout.astro';

function generateSlug(title) {
  if (!title) return 'post';
  return title
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/[\s_-]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

const query = `
  query {
    repository(owner: "jayantur13", name: "avarhq") {
      pinnedDiscussions(first: 5) {
        nodes {
          discussion {
            number
            title
            createdAt
            category {
              name
            }
            author {
              login
            }
          }
        }
      }
      discussions(first: 50, orderBy: {field: CREATED_AT, direction: DESC}) {
        nodes {
          number
          title
          createdAt
          category {
            name
          }
          author {
            login
          }
        }
      }
    }
  }
`;

let pinnedPosts = [];
let regularPosts = [];

try {
  const token =  import.meta.env.DISCUSS;
  const response = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'User-Agent': 'AVARHQ-Media-App',
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    },
    body: JSON.stringify({ query }),
  });

  if (response.ok) {
    const json = await response.json();
    const pinnedNodes = json.data?.repository?.pinnedDiscussions?.nodes || [];
    pinnedPosts = pinnedNodes.map((node) => node.discussion);

    const allDiscussions = json.data?.repository?.discussions?.nodes || [];
    const pinnedNumbers = pinnedPosts.map((p) => p.number);
    regularPosts = allDiscussions.filter((post) => !pinnedNumbers.includes(post.number));
  } else {
    console.error(`GitHub API responded with status ${response.status}: ${response.statusText}`);
  }
} catch (error) {
  console.error('Failed to load blog posts from GitHub:', error);
}

const formatDate = (dateString) => {
  return new Date(dateString).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
---

<BaseLayout title="Editorial & Archives | AVARHQ" 
  description="Official AVAR announcements, deep-dives, and living watchlists.">
  <header class="mb-12 border-b border-white/10 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tighter text-white drop-shadow-md mb-2">
        Editorial & Archives
      </h1>
      <p class="text-gray-400 text-lg font-medium tracking-wide">
        Official announcements, deep-dives, and living watchlists.
      </p>
    </div>
    
    <div class="relative w-full md:w-72">
      <input type="text" id="blog-search" placeholder="Search archives..." class="w-full bg-white/5 border border-white/10 rounded-lg py-3 px-4 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition-colors" />
      <svg class="w-4 h-4 text-gray-500 absolute right-4 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
    </div>
  </header>

  <div class="space-y-12">
    {pinnedPosts.length > 0 && (
      <section>
        <h2 class="text-xs text-yellow-500 font-black tracking-widest uppercase mb-4 flex items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M16 11V5.5C16 3.57 14.43 2 12.5 2S9 3.57 9 5.5V11L7 15v2h4.5v4h1v-4H17v-2l-2-4z"/></svg>
          Pinned Post
        </h2>
        <div class="flex flex-col border border-yellow-500/30 rounded-xl overflow-hidden bg-[#13151f]">
          {pinnedPosts.map((post, index) => (
            <a href={`/blog/${generateSlug(post.title)}-${post.number}`} class={`group flex flex-col md:flex-row md:items-center justify-between p-6 hover:bg-white/5 transition-colors ${index !== pinnedPosts.length - 1 ? 'border-b border-white/5' : ''}`}>
              <div class="flex flex-col gap-2">
                <span class="text-yellow-500 bg-yellow-500/10 border border-yellow-500/20 text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded w-max">
                  {post.category?.name || 'General'}
                </span>
                <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors leading-tight">
                  {post.title}
                </h3>
              </div>
              <div class="mt-4 md:mt-0 flex items-center gap-4 text-xs font-bold text-gray-500 uppercase tracking-widest text-right">
                <span>{formatDate(post.createdAt)}</span>
                <span class="text-white/20 hidden md:block">•</span>
                <span class="hidden md:block">By AVARHQ</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {regularPosts.length > 0 && (
      <section>
        <div class="flex items-end justify-between mb-4 border-b border-white/10 pb-2">
          <h2 class="text-sm font-bold uppercase tracking-widest text-gray-400">Latest Updates</h2>
        </div>
        
        <div class="flex flex-col min-h-[400px]" id="post-container">
          {regularPosts.map((post) => (
            <a href={`/blog/${generateSlug(post.title)}-${post.number}`} data-title={post.title} class="blog-post group flex flex-col md:flex-row md:items-center justify-between py-5 border-b border-white/5 hover:bg-white/5 transition-colors -mx-4 px-4 rounded-lg">
              <div class="flex items-center gap-4">
                <div class="hidden md:flex flex-col items-center justify-center w-12 h-12 rounded bg-white/5 border border-white/10 text-gray-500 group-hover:border-cyan-500/50 group-hover:text-cyan-400 transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                </div>
                <div class="flex flex-col gap-1.5">
                  <h3 class="text-base md:text-lg font-bold text-gray-200 group-hover:text-cyan-400 transition-colors">
                    {post.title}
                  </h3>
                  <span class="text-cyan-500/70 text-[10px] font-black uppercase tracking-widest">
                    {post.category?.name || 'General'}
                  </span>
                </div>
              </div>
              <div class="mt-2 md:mt-0 text-[10px] font-bold text-gray-500 uppercase tracking-widest">
                {formatDate(post.createdAt)}
              </div>
            </a>
          ))}
          <div id="no-results" class="hidden py-10 text-center text-gray-500 font-bold uppercase tracking-widest text-sm">
            No transmissions found.
          </div>
        </div>

        <div class="flex items-center justify-between mt-8" id="pagination-controls">
            <button id="prev-page" class="px-4 py-2 border border-white/10 rounded-lg text-xs font-bold uppercase tracking-widest text-white disabled:opacity-30 disabled:cursor-not-allowed hover:bg-white/5 transition-colors">Prev</button>
            <span id="page-info" class="text-xs font-bold uppercase tracking-widest text-gray-500">Page 1 of 1</span>
            <button id="next-page" class="px-4 py-2 border border-white/10 rounded-lg text-xs font-bold uppercase tracking-widest text-white disabled:opacity-30 disabled:cursor-not-allowed hover:bg-white/5 transition-colors">Next</button>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  function initBlog() {
    const searchInput = document.getElementById('blog-search');
    const posts = Array.from(document.querySelectorAll('.blog-post'));
    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');
    const pageInfo = document.getElementById('page-info');
    const noResults = document.getElementById('no-results');
    
    if (!searchInput || posts.length === 0) return;

    let currentPage = 1;
    const itemsPerPage = 8;

    function renderView() {
      const query = searchInput.value.toLowerCase().trim();
      
      const filtered = posts.filter(post => {
        const title = (post.getAttribute('data-title') || '').toLowerCase();
        const matches = title.includes(query);
        return matches;
      });

      if (noResults) noResults.style.display = filtered.length === 0 ? 'block' : 'none';

      const totalPages = Math.max(1, Math.ceil(filtered.length / itemsPerPage));
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;

      posts.forEach(post => (post.style.display = 'none'));
      filtered.forEach((post, index) => {
        if (index >= start && index < end) {
          post.style.display = 'flex';
        }
      });

      if (pageInfo) pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages || filtered.length === 0;
    }

    searchInput.addEventListener('input', () => { currentPage = 1; renderView(); });
    prevBtn?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderView(); } });
    nextBtn?.addEventListener('click', () => { currentPage++; renderView(); });

    renderView();
  }

  // Runs on initial document load and handles Astro view transitions
  initBlog();
  document.addEventListener('astro:page-load', initBlog);
</script>