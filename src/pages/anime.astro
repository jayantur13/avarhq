---
import BaseLayout from '../layouts/BaseLayout.astro';

// 1. Grab the ID from the URL
const id = Astro.url.searchParams.get('id');

// 2. Default Fallbacks
let seoTitle = "Database | AVARHQ";
let seoDesc = "View comprehensive anime metadata, release countdowns, and verified streaming platforms.";
let seoImage = "/og-default.png"; 

let media = null;
let countdownText = null;
let formattedFormat = 'TV';
let formattedSeason = 'TBA';
let fetchError = null;

// 3. Complete Server-Side Fetch with Diagnostics
if (id) {
  const animeId = Number(id);

  if (!Number.isInteger(animeId) || animeId <= 0) {
    fetchError = `Invalid AniList ID: ${id}`;
  } else {
    try {
      const response = await fetch('https://graphql.anilist.co', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          query: `
            query ($id: Int) {
              Media(id: $id, type: ANIME) {
                id
                idMal
                status
                title { english romaji }
                description(asHtml: true)
                coverImage { extraLarge }
                bannerImage
                format season seasonYear episodes averageScore
                genres
                nextAiringEpisode { episode timeUntilAiring }
              }
            }
          `,
          variables: { id: animeId },
        }),
      });

      const body = await response.text();

      let json;
      try {
        json = JSON.parse(body);
      } catch {
        throw new Error(
          `AniList returned non-JSON data (HTTP ${response.status}): ${body.slice(0, 300)}`
        );
      }

      if (!response.ok || json.errors?.length) {
        console.error('AniList request failed:', {
          animeId,
          httpStatus: response.status,
          errors: json.errors,
          rateLimitRemaining: response.headers.get('X-RateLimit-Remaining'),
        });

        throw new Error(
          `AniList HTTP ${response.status}: ${
            json.errors?.map((e) => e.message).join('; ') || 'Request failed'
          }`
        );
      }

      media = json.data?.Media ?? null;

      if (!media) {
        fetchError = `AniList returned no anime for ID ${animeId}.`;
      } else {
        // Populate SEO and formatting variables on success
        seoTitle = `${media.title.english || media.title.romaji} | AVAR Database`;
        
        if (media.description) {
          seoDesc = media.description.replace(/<[^>]*>?/gm, '').substring(0, 160) + '...';
        }
        seoImage = media.bannerImage || media.coverImage?.extraLarge || seoImage;

        formattedFormat = (media.format || 'TV').replace('TV_SHORT', 'SHORT');
        formattedSeason = `${media.season || ''} ${media.seasonYear || 'TBA'}`.trim();

        if (media.status === 'RELEASING' && media.nextAiringEpisode) {
          const seconds = media.nextAiringEpisode.timeUntilAiring;
          if (seconds > 0) {
              const d = Math.floor(seconds / 86400);
              const h = Math.floor((seconds % 86400) / 3600);
              countdownText = `New Ep ${media.nextAiringEpisode.episode} in ${d}d ${h}h`;
          }
        }
      }
    } catch (error) {
      console.error('Anime detail fetch failed:', error);
      fetchError = error instanceof Error ? error.message : 'Unknown AniList error';
    }
  }
} else {
  fetchError = 'No anime ID provided in the URL parameters.';
}
---

<BaseLayout title={seoTitle} description={seoDesc} image={seoImage}>
  
  {!media ? (
    <div id="error-state" class="w-full max-w-5xl mx-auto px-6 py-24 flex flex-col items-center justify-center text-center space-y-6 min-h-[60vh]">
      <h2 class="text-3xl font-black uppercase tracking-widest text-red-500">Transmission Failed</h2>
      <p class="text-sm font-bold text-gray-400 uppercase tracking-widest">{fetchError}</p>
      <a href="/discover" class="px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg text-xs font-bold uppercase tracking-widest text-white transition-colors">Return to Archives</a>
    </div>
  ) : (
    <article id="content-state" class="w-full" data-mal-id={media.idMal} data-anime-id={media.id} data-anime-title={media.title.english || media.title.romaji} data-anime-cover={media.coverImage?.extraLarge || ''} data-anime-format={formattedFormat} data-anime-status={media.status}>
      
      <div class="w-full h-[40vh] md:h-[50vh] relative overflow-hidden bg-[#0a0c12]">
        <img src={media.bannerImage || media.coverImage?.extraLarge || ''} alt="Banner" class="absolute inset-0 w-full h-full object-cover opacity-50" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c12] via-[#0a0c12]/80 to-transparent"></div>
      </div>

      <div class="max-w-6xl mx-auto px-6 -mt-32 md:-mt-48 relative z-10 flex flex-col md:flex-row gap-8 md:gap-12 pb-24">
        
        <div class="w-full md:w-1/3 lg:w-1/4 flex flex-col gap-6">
          <div class="relative aspect-[2/3] rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#13151f]">
            <img src={media.coverImage?.extraLarge || ''} alt="Poster" class="w-full h-full object-cover" />
          </div>
          
          <div class="flex flex-col gap-3 p-5 bg-[#13151f] border border-white/10 rounded-xl">
            <div class="flex justify-between items-center border-b border-white/5 pb-2 text-xs font-bold uppercase tracking-widest">
              <span class="text-gray-500">Format</span>
              <span class="text-white">{formattedFormat}</span>
            </div>
            <div class="flex justify-between items-center border-b border-white/5 pb-2 text-xs font-bold uppercase tracking-widest">
              <span class="text-gray-500">Season</span>
              <span class="text-white">{formattedSeason}</span>
            </div>
            <div class="flex justify-between items-center border-b border-white/5 pb-2 text-xs font-bold uppercase tracking-widest">
              <span class="text-gray-500">Episodes</span>
              <span class="text-white">{media.episodes || 'TBA'}</span>
            </div>
            <div class="flex justify-between items-center text-xs font-bold uppercase tracking-widest">
              <span class="text-gray-500">Score</span>
              <span class="text-cyan-400">{media.averageScore ? `${media.averageScore}%` : 'N/A'}</span>
            </div>
          </div>
        </div>

        <div class="w-full md:w-2/3 lg:w-3/4 flex flex-col pt-4 md:pt-16">
          
          {countdownText && (
            <div class="mb-4">
                <span class="text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded bg-cyan-900/40 border border-cyan-500/30 text-cyan-300">
                  {countdownText}
                </span>
            </div>
          )}

          <div class="flex items-center gap-4 mb-3">
            <button id="fav-btn" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-black uppercase tracking-widest text-gray-300 hover:text-white transition-all flex items-center gap-2">
              <span id="fav-star" class="text-base text-gray-500">★</span>
              <span id="fav-label">Add to Watchlist</span>
            </button>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter text-white leading-tight mb-4 drop-shadow-md">
            {media.title.english || media.title.romaji}
          </h1>
          
          <div class="flex flex-wrap gap-2 mb-8">
            {media.genres?.map((g: string) => (
              <span class="text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded bg-white/5 border border-white/10 text-gray-300">
                {g}
              </span>
            ))}
          </div>

          <div class="space-y-4 mb-12">
            <h2 class="text-sm font-bold uppercase tracking-widest text-white border-b border-white/10 pb-2">Synopsis</h2>
            <div class="text-gray-400 text-sm md:text-base leading-relaxed space-y-4" set:html={media.description || 'No synopsis available in the registry.'}></div>
          </div>

          <div class="space-y-4 p-6 bg-[#13151f] border border-white/10 rounded-xl">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <h2 class="text-sm font-bold uppercase tracking-widest text-cyan-400 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Official Streaming Platforms
              </h2>
              <span id="stream-status" class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Querying Jikan...</span>
            </div>
            <div id="streaming-list" class="flex flex-wrap gap-3">
               <span class="text-xs text-gray-500 animate-pulse font-bold uppercase tracking-widest">Searching verified channels...</span>
            </div>
          </div>

        </div>
      </div>
    </article>
  )}
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const article = document.getElementById('content-state');
    if (!article) return; // Exit if rendering the error state

    // Read metadata passed securely from the server
    const malId = article.getAttribute('data-mal-id');
    const animeId = article.getAttribute('data-anime-id');
    const animeTitle = article.getAttribute('data-anime-title');
    const animeCover = article.getAttribute('data-anime-cover');
    const animeFormat = article.getAttribute('data-anime-format');
    const animeStatus = article.getAttribute('data-anime-status');

    // --- STREAMING LINKS (Client-Side to avoid server rate limits) ---
    async function fetchStreamingChannels(malId) {
      const listContainer = document.getElementById('streaming-list');
      const statusText = document.getElementById('stream-status');

      try {
        const res = await fetch(`https://jikan.lucashdo.com/v1/anime/${malId}/full`);
        if (!res.ok) throw new Error();

        const json = await res.json();
        const streams = json?.data?.streaming || [];

        if (!listContainer) return;
        listContainer.innerHTML = '';

        if (streams.length === 0) {
          if (statusText) statusText.textContent = 'None Detected';
          listContainer.innerHTML = '<span class="text-xs font-bold uppercase tracking-widest text-gray-500">Try searching on internet instead.</span>';
        } else {
          if (statusText) statusText.textContent = 'Verified';
          streams.forEach(st => {
            const a = document.createElement('a');
            a.href = st.url;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            a.className = 'text-[10px] md:text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-lg bg-white/5 hover:bg-cyan-500/20 text-gray-200 hover:text-cyan-300 border border-white/10 hover:border-cyan-500/30 transition-colors flex items-center gap-2';
            a.innerHTML = `<span>${st.name}</span><span class="text-gray-500">↗</span>`;
            listContainer.appendChild(a);
          });
          
          const disclaimer = document.createElement('div');
          disclaimer.className = "w-full mt-2 text-[9px] font-bold text-gray-500 uppercase tracking-widest";
          disclaimer.textContent = "* Availability varies by country";
          listContainer.appendChild(disclaimer);
        }
      } catch {
        if (statusText) statusText.textContent = 'Unavailable';
        if (listContainer) listContainer.innerHTML = '<span class="text-xs font-bold uppercase tracking-widest text-gray-500">Try searching on internet instead.</span>';
      }
    }

    if (malId && malId !== 'null') {
      setTimeout(() => fetchStreamingChannels(malId), 500); 
    } else {
      const statusText = document.getElementById('stream-status');
      const listContainer = document.getElementById('streaming-list');
      if (statusText) statusText.textContent = 'Unregistered';
      if (listContainer) listContainer.innerHTML = '<span class="text-xs font-bold uppercase tracking-widest text-gray-500">Try searching on internet instead.</span>';
    }

    // --- WATCHLIST LOGIC (Client-Side) ---
    const FAV_KEY = 'avar_user_watchlist';

    function getStoredWatchlist() {
      try {
        return JSON.parse(localStorage.getItem(FAV_KEY)) || [];
      } catch {
        return [];
      }
    }

    function checkIsFavorite(id) {
      return getStoredWatchlist().some(item => String(item.id) === String(id));
    }

    function updateButtonUI(isFavorited) {
      const star = document.getElementById('fav-star');
      const label = document.getElementById('fav-label');
      const btn = document.getElementById('fav-btn');

      if (!star || !label || !btn) return;

      if (isFavorited) {
        star.className = 'text-base text-yellow-400 transition-colors';
        label.textContent = 'In Watchlist';
        btn.classList.add('border-yellow-500/40', 'bg-yellow-500/10');
        btn.classList.remove('border-white/10', 'bg-white/5');
      } else {
        star.className = 'text-base text-gray-500 transition-colors';
        label.textContent = 'Add to Watchlist';
        btn.classList.remove('border-yellow-500/40', 'bg-yellow-500/10');
        btn.classList.add('border-white/10', 'bg-white/5');
      }
    }

    const btn = document.getElementById('fav-btn');
    if (btn) {
      let isCurrentlyFav = checkIsFavorite(animeId);
      updateButtonUI(isCurrentlyFav);

      btn.onclick = (e) => {
        e.preventDefault();
        let list = getStoredWatchlist();
        isCurrentlyFav = checkIsFavorite(animeId);

        if (isCurrentlyFav) {
          list = list.filter(item => String(item.id) !== String(animeId));
          isCurrentlyFav = false;
        } else {
          list.push({
            id: Number(animeId),
            title: animeTitle,
            cover: animeCover,
            format: animeFormat,
            status: animeStatus
          });
          isCurrentlyFav = true;
        }
        localStorage.setItem(FAV_KEY, JSON.stringify(list));
        updateButtonUI(isCurrentlyFav);
      };
    }
  });
</script>