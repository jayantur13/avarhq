  "binge_profiles": [
    {
      "title_english": "Death Note",
      "title_romaji": "DEATH NOTE",
      "cover_image": "https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx1535-kUgkcrfOrkUM.jpg",
