---
---
<header class="w-full sticky top-0 z-50 bg-[#0a0c12]/80 backdrop-blur-md border-b border-white/10 transition-all duration-300">
  <nav class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center relative">
    
    <!-- AVAR Brand Identity -->
    <a href="/" class="flex items-baseline gap-2 group">
      <span class="text-2xl font-black tracking-tighter text-white group-hover:text-cyan-400 transition-colors">AVAR</span>
      <span class="text-xs font-semibold tracking-widest text-gray-500 uppercase hidden sm:block">Creative Media</span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden md:flex items-center space-x-8 text-sm font-bold uppercase tracking-wider text-gray-400">
      <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
      <li><a href="/discover" class="hover:text-white transition-colors">Discover</a></li>
      <li><a href="/search" class="hover:text-white transition-colors">Search</a></li>
      <li><a href="/watchlist" class="hover:text-white transition-colors">Watchlist</a></li>
      <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
      <li><a href="/shop" class="hover:text-white transition-colors">Shop</a></li>
      
      <!-- Dropdown Menu -->
      <li class="relative group cursor-pointer py-6">
        <span class="hover:text-white transition-colors flex items-center gap-1">
          Other 
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </span>
        <div class="absolute right-0 top-[70px] w-48 bg-[#13151f] border border-white/10 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right group-hover:translate-y-0 translate-y-2 z-50 overflow-hidden">
          <a href="/about" class="block px-5 py-3 hover:bg-white/5 hover:text-cyan-400 transition-colors">About Us</a>
          <a href="/policies/tos" class="block px-5 py-3 hover:bg-white/5 hover:text-cyan-400 transition-colors">Terms of Service</a>
          <a href="/policies/privacy" class="block px-5 py-3 hover:bg-white/5 hover:text-cyan-400 transition-colors">Privacy Policy</a>
        </div>
      </li>
    </ul>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-gray-400 hover:text-white focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </nav>

  <!-- Mobile Dropdown Container -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#0a0c12] border-b border-white/10 shadow-2xl flex-col">
    <ul class="flex flex-col text-sm font-bold uppercase tracking-wider text-gray-400 py-4 px-6 divide-y divide-white/5">
      <li><a href="/" class="block py-4 hover:text-cyan-400 transition-colors">Home</a></li>
      <li><a href="/discover" class="block py-4 hover:text-cyan-400 transition-colors">Discover</a></li>
      <li><a href="/search" class="block py-4 hover:text-cyan-400 transition-colors">Search</a></li>
      <li><a href="/watchlist" class="block py-4 hover:text-cyan-400 transition-colors">Watchlist</a></li>
      <li><a href="/blog" class="block py-4 hover:text-cyan-400 transition-colors">Blog</a></li>
      <li><a href="/shop" class="block py-4 hover:text-cyan-400 transition-colors">Shop</a></li>
      <li><a href="/about" class="block py-4 hover:text-cyan-400 transition-colors text-gray-500">About Us</a></li>
      <li><a href="/policies/tos" class="block py-4 hover:text-cyan-400 transition-colors text-gray-500">Terms of Service</a></li>
      <li><a href="/policies/privacy" class="block py-4 hover:text-cyan-400 transition-colors text-gray-500">Privacy Policy</a></li>
    </ul>
  </div>
</header>

<script>
  // Wait for the DOM to load before attaching event listeners
  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => {
        // Toggles Tailwind's 'hidden' and 'flex' classes to show/hide the menu
        mobileMenu.classList.toggle('hidden');
        mobileMenu.classList.toggle('flex');
      });
    }
  });
</script>