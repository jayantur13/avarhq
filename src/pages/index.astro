---
import BaseLayout from '../layouts/BaseLayout.astro';
import RandomEntry from '../components/RandomEntry.astro';

const BASE_RES = import.meta.env.BASE_URL_FILE;
const f1 = 'daily.json';
const f2 = 'airing_today_reel.json';
// Fetch live data concurrently
const [dailyRes, airingRes] = await Promise.all([
  fetch(`${BASE_RES}/${f1}`),
  fetch(`${BASE_RES}/${f2}`)
]);

const dailyData = dailyRes.ok ? await dailyRes.json() : {};
const airingTodayData = airingRes.ok ? await airingRes.json() : [];

// Extract metadata and arrays
const lastUpdated = dailyData.metadata?.last_updated || 'Recently';
const airingToday = Array.isArray(airingTodayData) ? airingTodayData : (airingTodayData.data || []);

// Filter Active Stream strictly to RELEASING status
const activeNow = (dailyData.active_now || []).filter(anime => anime.status === 'RELEASING');

// Sort Top 10 strictly by average_score
const trendingTop10 = (dailyData.trending_top10 || [])
  .sort((a, b) => (b.average_score || 0) - (a.average_score || 0))
  .slice(0, 10);
  
const birthdays = dailyData.birthdays || [];
const bingeProfiles = dailyData.binge_profiles || []; // Added for space if needed

// Helper Functions
const formatCountdown = (seconds, status) => {
  if (status !== 'RELEASING' || !seconds || seconds <= 0) return null;
  const w = Math.floor(seconds / (3600 * 24 * 7));
  const d = Math.floor((seconds % (3600 * 24 * 7)) / (3600 * 24));
  const h = Math.floor((seconds % (3600 * 24)) / 3600);
  if (w > 0) return `${w}w ${d}d`;
  if (d > 0) return `${d}d ${h}h`;
  if (h > 0) return `${h}h`;
  return 'Soon';
};

function formatTimestamp(isoString) {
  const date = new Date(isoString);
  
  return new Intl.DateTimeFormat('en-US', {
    dateStyle: 'medium', // Options: 'short', 'medium', 'long', 'full'
    timeStyle: 'short'  // Options: 'short', 'medium', 'long', 'full'
  }).format(date);
}

function formatDateUTC(dateStr) {
  const date = new Date(dateStr); // "2026-10-20" is parsed as UTC midnight
  
  return new Intl.DateTimeFormat('en-US', {
    dateStyle: 'short',
    timeZone: 'UTC' // Forces the formatting to stay in UTC
  }).format(date);
}

const heroDroppingStatus = airingTodayData.date === new Date().toISOString().split('T')[0] ? "Airing Today" : "Already Aired";

const getTitle = (anime) => anime?.title_english || anime?.title_romaji || 'Unknown Title';
const getMetadataTag = (anime) => `${(anime?.format || 'TV').replace("TV_SHORT", "SHORT")} • ${anime?.season || ''} ${anime?.season_year || ''}`.replace(/^[•\s]+|[•\s]+$/g, '').trim();
---

<BaseLayout
  title="The Digital Anime Archive | AVARHQ" 
  description="Discover dropping today, active streams, and trending anime with live AniList and Jikan data synchronization. No ads, no tracking.">
  <RandomEntry
    airingToday={airingToday}
    trending={trendingTop10}
  />


    <div class="w-full max-w-7xl mx-auto px-6 py-8 space-y-16">
        
        <!-- Live DB Status -->
        <div class="bg-[#13151f] border border-white/10 rounded-xl p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-lg">
            <div class="flex items-center gap-3">
                <span class="relative flex h-3 w-3 flex-shrink-0">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
                </span>
                <p class="text-xs text-gray-300 font-bold tracking-widest uppercase leading-tight">
                    <span class="text-white">Website auto-update on</span> {formatTimestamp(lastUpdated)}
                </p>
            </div>
            <a href="/discover" class="text-[10px] bg-white/5 hover:bg-white/10 border border-white/10 text-white px-3 py-1.5 rounded-full font-black uppercase tracking-widest transition-colors whitespace-nowrap">
                Explore Archives
            </a>
        </div>
        
        <!-- HERO: Airing Today Auto-Carousel -->
        {airingToday.length > 0 && (
            <div class="relative w-full h-[460px] md:h-[60vh] rounded-3xl overflow-hidden shadow-[0_0_40px_rgba(0,0,0,0.5)] border border-white/10">
                <div id="hero-carousel" class="w-full h-full relative">
                    {airingToday.slice(0, 5).map((heroItem, index) => {
                        const countdownText = formatCountdown(heroItem.next_ep_time, heroItem.status || 'RELEASING');
                        return (
                        <a href={`/anime?id=${heroItem.id}&title=${encodeURIComponent(getTitle(heroItem))}`} 
                           class={`carousel-item absolute inset-0 transition-opacity duration-1000 ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}>
                            <div class="absolute inset-0 bg-cover bg-center md:bg-[center_top_20%]" 
                                 style={`background-image: url('${heroItem.banner_image || heroItem.cover_image || ''}');`}></div>
                            
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c12] via-[#0a0c12]/80 md:via-[#0a0c12]/60 to-transparent"></div>
                            
                            <div class="absolute inset-0 p-6 md:p-10 flex flex-col justify-end items-start gap-3 md:gap-4 z-10 max-w-3xl">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="bg-red-500/90 backdrop-blur-md border border-red-400 text-[9px] md:text-[10px] font-black uppercase tracking-widest px-2.5 md:px-3 py-1 rounded-full text-white animate-pulse">
                                        {heroDroppingStatus}
                                    </span>
                                    <span class="bg-white/10 backdrop-blur-md border border-white/20 text-[9px] md:text-[10px] font-black uppercase tracking-widest px-2.5 md:px-3 py-1 rounded-full text-white">
                                        {getMetadataTag(heroItem)}
                                    </span>
                                </div>
                                
                                <h1 class="text-2xl sm:text-4xl md:text-6xl font-black uppercase tracking-tighter drop-shadow-lg text-white leading-tight line-clamp-3 md:line-clamp-2">
                                    {getTitle(heroItem)}
                                </h1>
                                
                                <div class="flex flex-wrap items-center gap-3 md:gap-4 text-xs md:text-sm font-bold tracking-widest uppercase mt-1">
                                    {countdownText && (
                                        <span class="text-cyan-400 bg-cyan-900/40 px-2.5 md:px-3 py-1 rounded border border-cyan-500/30 flex items-center gap-1.5 md:gap-2 text-[11px] md:text-xs">
                                           {formatDateUTC(airingTodayData.date)} <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span> Ep {heroItem.next_ep}: {countdownText}
                                        </span>
                                    )}
                                    <span class="text-gray-400 hover:text-cyan-400 text-[10px] md:text-xs tracking-widest font-black uppercase transition-colors flex items-center gap-1">
                                        More Details <span>↗</span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    )})}
                </div>
                
                <!-- Carousel Indicators -->
                <div class="absolute bottom-6 right-6 z-20 flex gap-2">
                    {airingToday.slice(0, 5).map((_, i) => (
                        <div class={`carousel-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-cyan-400' : 'bg-white/30'}`}></div>
                    ))}
                </div>
            </div>
        )}

        <!-- NEW EPISODES / AIRING TODAY GRID -->
        <section>
    <div class="flex items-end justify-between border-b border-white/10 pb-4 mb-6">
        <h2 class="text-2xl font-bold uppercase tracking-wide text-white">New Episodes Today</h2>
    </div>

    {airingToday.slice(5).length > 0 ? (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {airingToday.slice(5).map((anime) => {
                const cd = formatCountdown(anime.next_ep_time, anime.status || 'RELEASING');
                return (
                    <a href={`/anime?id=${anime.id}&title=${encodeURIComponent(getTitle(anime))}`} class="group relative aspect-[2/3] rounded-2xl overflow-hidden bg-[#13151f] border border-white/5 hover:-translate-y-1 hover:border-red-500/50 transition-all duration-300">
                        <img src={anime.cover_image || ''} class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity" loading="lazy" />
                        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c12] via-[#0a0c12]/50 to-transparent"></div>
                        {cd && (
                            <div class="absolute top-3 right-3 bg-red-500/90 backdrop-blur-md border border-white/10 text-[9px] text-white font-black px-2 py-1 rounded uppercase tracking-widest">
                                In {cd}
                            </div>
                        )}
                        <div class="absolute bottom-0 left-0 p-5 w-full text-white">
                            <h3 class="text-lg font-black uppercase leading-tight line-clamp-2">{getTitle(anime)}</h3>
                        </div>
                    </a>
                )
            })}
        </div>
    ) : (
        /* Fallback content when no elements remain after slicing */
        <div class="flex items-center justify-center p-12 text-center border border-white/5 rounded-2xl bg-[#13151f]/50">
            <p class="text-white/40 text-sm font-medium tracking-wide uppercase">No new episodes available right now</p>
        </div>
    )}
</section>


        <!-- ACTIVE STREAM (Strictly Releasing) -->
        {activeNow.length > 0 && (
            <section>
                <div class="flex items-end justify-between border-b border-white/10 pb-4 mb-6">
                    <h2 class="text-2xl font-bold uppercase tracking-wide text-white">Active Stream</h2>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    {activeNow.slice(0, 8).map((anime) => {
                        const cd = formatCountdown(anime.next_ep_time, anime.status || 'RELEASING');
                        return (
                        <a href={`/anime?id=${anime.id}&title=${encodeURIComponent(getTitle(anime))}`} class="group relative aspect-[2/3] rounded-2xl overflow-hidden bg-[#13151f] border border-white/5 hover:-translate-y-1 hover:border-cyan-500/50 transition-all duration-300">
                            <img src={anime.cover_image || ''} class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity" loading="lazy" />
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c12] via-[#0a0c12]/50 to-transparent"></div>
                            {cd && (
                                <div class="absolute top-3 right-3 bg-black/80 backdrop-blur-md border border-white/10 text-[9px] text-cyan-400 font-black px-2 py-1 rounded uppercase tracking-widest shadow-lg">
                                    Ep {anime.next_ep} in {cd}
                                </div>
                            )}
                            <div class="absolute bottom-0 left-0 p-5 w-full text-white">
                                <h3 class="text-lg font-black uppercase leading-tight line-clamp-2">{getTitle(anime)}</h3>
                                <p class="text-[10px] text-gray-400 mt-2 font-bold tracking-widest uppercase block">{getMetadataTag(anime)}</p>
                            </div>
                        </a>
                    )})}
                </div>
            </section>
        )}

        <!-- LIVE TRENDING TOP 10 (Sorted by Score) -->
        {trendingTop10.length > 0 && (
            <section>
                <div class="flex items-end justify-between mb-8 border-b border-white/10 pb-4">
                <h2 class="text-2xl font-bold uppercase tracking-wide text-white">Live Trending</h2>
                <span class="text-xs text-orange-400 font-bold tracking-widest uppercase px-0 py-1">Global Charts</span>
                </div>
                <div class="relative group">
                    <!-- Left Arrow -->
                    <button id="trend-left" class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-5 z-20 w-12 h-12 bg-[#0a0c12] hover:bg-orange-500 text-white border border-white/10 hover:border-orange-400 rounded-full items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-[0_0_20px_rgba(0,0,0,0.8)] focus:outline-none">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>

                    <!-- Scroll Container -->
                    <div id="trend-scroll" class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory scroll-smooth hide-scrollbar relative z-10">
                        {trendingTop10.map((anime, index) => (
                            <a href={`/anime?id=${anime.id}&title=${encodeURIComponent(getTitle(anime))}`} class="snap-start flex-shrink-0 w-64 group/card relative aspect-[3/4] rounded-2xl overflow-hidden bg-[#13151f] border border-white/5 hover:border-orange-500/50 transition-colors">
                                <img src={anime.cover_image || ''} class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover/card:opacity-100 transition-opacity" loading="lazy" />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c12] via-[#0a0c12]/40 to-transparent"></div>
                                <div class="absolute top-3 left-3 w-8 h-8 rounded bg-orange-500 text-black flex items-center justify-center font-black text-lg z-10 shadow-lg">#{index + 1}</div>
                                <div class="absolute bottom-0 left-0 p-4 w-full text-white z-10">
                                    <h3 class="text-base font-black uppercase leading-tight line-clamp-2 mb-1">{getTitle(anime)}</h3>
                                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Score: {anime.average_score}%</span>
                                </div>
                            </a>
                        ))}
                    </div>

                    <!-- Right Arrow -->
                    <button id="trend-right" class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-5 z-20 w-12 h-12 bg-[#0a0c12] hover:bg-orange-500 text-white border border-white/10 hover:border-orange-400 rounded-full items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-[0_0_20px_rgba(0,0,0,0.8)] focus:outline-none">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
            </section>
        )}

    </div>
</BaseLayout>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Carousel Logic
    const items = document.querySelectorAll('.carousel-item');
    const dots = document.querySelectorAll('.carousel-dot');
    let currentIndex = 0;

    if (items.length > 1) {
        setInterval(() => {
            // Hide current
            items[currentIndex].classList.remove('opacity-100', 'z-10');
            items[currentIndex].classList.add('opacity-0', 'z-0', 'pointer-events-none');
            dots[currentIndex].classList.remove('bg-cyan-400');
            dots[currentIndex].classList.add('bg-white/30');

            // Move to next
            currentIndex = (currentIndex + 1) % items.length;

            // Show next
            items[currentIndex].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
            items[currentIndex].classList.add('opacity-100', 'z-10');
            dots[currentIndex].classList.remove('bg-white/30');
            dots[currentIndex].classList.add('bg-cyan-400');
        }, 5000); // 5 second rotation
    }

    // Trending Scroll Logic
    const scrollContainer = document.getElementById('trend-scroll');
    const leftBtn = document.getElementById('trend-left');
    const rightBtn = document.getElementById('trend-right');

    if (scrollContainer && leftBtn && rightBtn) {
      const scrollAmount = 280;
      leftBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
      rightBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>