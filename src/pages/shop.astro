---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Shop | AVARHQ" 
  description="Support the archive. Browse exclusive AVARHQ merchandise and digital assets.">
  <div class="w-full max-w-4xl mx-auto px-6 py-32 flex flex-col items-center justify-center text-center min-h-[70vh]">
    <div class="w-20 h-20 mb-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-500">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
    </div>
    
    <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-white mb-6">
      Shop Offline
    </h1>
    
    <p class="text-lg text-gray-400 font-medium tracking-wide max-w-xl mb-12">
      The AVAR storefront is currently undergoing maintenance and inventory updates. We will be back online soon.
    </p>
  
  </div>
</BaseLayout>