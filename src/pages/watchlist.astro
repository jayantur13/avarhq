---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="My Watchlist | AVARHQ" 
  description="Track your pinned anime dynamically via live AniList feeds and sync your personal radar across devices.">
  <div class="max-w-7xl mx-auto px-6 py-12 space-y-12">
    
    <header class="border-b border-white/10 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tighter text-white drop-shadow-md mb-2">
          Personal Radar
        </h1>
        <p class="text-gray-400 text-lg font-medium tracking-wide">
          Tracking your pinned anime dynamically via live AniList feeds.
        </p>
      </div>

      <!-- RSS Feed Subscribe Button -->
      <a href="feed.xml" target="_blank" class="flex items-center gap-2 px-4 py-2.5 bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-orange-400 rounded-xl text-xs font-black uppercase tracking-widest transition-colors w-max">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
        Subscribe to RSS
      </a>
    </header>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-20 border border-white/5 bg-[#13151f] rounded-3xl space-y-4">
      <div class="text-4xl">★</div>
      <h2 class="text-xl font-black uppercase tracking-widest text-white">Your Watchlist is Empty</h2>
      <p class="text-xs text-gray-500 uppercase tracking-widest">Pin shows from the Home or Discover page to track them here.</p>
      <a href="/discover" class="inline-block px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-widest text-white transition-colors">Browse Catalog</a>
    </div>

    <!-- Active Loading Spinner -->
    <div id="loading-state" class="py-20 flex flex-col items-center justify-center space-y-4">
      <div class="w-10 h-10 border-4 border-white/10 border-t-cyan-500 rounded-full animate-spin"></div>
      <span class="text-xs font-bold uppercase tracking-widest text-gray-400">Synchronizing Local Radar...</span>
    </div>

    <!-- Watchlist Grid -->
    <div id="watchlist-grid" class="hidden grid grid-cols-2 md:grid-cols-4 gap-6"></div>

  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const rawFavs = localStorage.getItem('avar_user_watchlist');
    const localList = rawFavs ? JSON.parse(rawFavs) : [];
    const emptyState = document.getElementById('empty-state');
    const loadingState = document.getElementById('loading-state');
    const grid = document.getElementById('watchlist-grid');

    if (!localList || localList.length === 0) {
      loadingState?.classList.add('hidden');
      emptyState?.classList.remove('hidden');
      return;
    }

    const ids = localList.map(item => item.id);

    // Batched AniList Query
    const query = `
      query ($ids: [Int]) {
        Page(page: 1, perPage: 50) {
          media(id_in: $ids) {
            id
            status
            format
            title { english romaji }
            coverImage { extraLarge }
            nextAiringEpisode { episode timeUntilAiring }
            startDate { year month day }
            averageScore
          }
        }
      }
    `;

    try {
      const res = await fetch('https://graphql.anilist.co', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, variables: { ids } })
      });

      const json = await res.json();
      const animeList = json?.data?.Page?.media || [];

      loadingState?.classList.add('hidden');
      grid?.classList.remove('hidden');

      grid.innerHTML = animeList.map(anime => {
        const title = anime.title.english || anime.title.romaji;
        let badgeHtml = '';

        // Status 1: Airing Now (Countdown Badge)
        if (anime.status === 'RELEASING' && anime.nextAiringEpisode) {
          const s = anime.nextAiringEpisode.timeUntilAiring;
          const d = Math.floor(s / 86400);
          const h = Math.floor((s % 86400) / 3600);
          badgeHtml = `<span class="bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded">New Ep ${anime.nextAiringEpisode.episode} in ${d}d ${h}h</span>`;
        } 
        // Status 2: Unreleased (Premiere Date Badge)
        else if (anime.status === 'NOT_YET_RELEASED') {
          const start = anime.startDate?.year ? `${anime.startDate.month || '?'}/${anime.startDate.year}` : 'TBA';
          badgeHtml = `<span class="bg-purple-500/20 text-purple-300 border border-purple-500/30 text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded">Dropping ${start}</span>`;
        } 
        // Status 3: Finished / Archived
        else {
          badgeHtml = `<span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded">Score • ${anime.averageScore || 'N/A'}%</span>`;
        }

        return `
          <a href="/anime?id=${anime.id}" class="group relative aspect-[2/3] rounded-2xl overflow-hidden bg-[#13151f] border border-white/5 hover:border-cyan-500/50 transition-all duration-300 flex flex-col justify-end p-5">
            <img src="${anime.coverImage.extraLarge}" class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity" alt="Cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c12] via-[#0a0c12]/50 to-transparent"></div>
            
            <div class="relative z-10 flex flex-col gap-2">
              <div class="flex items-center gap-2">${badgeHtml}</div>
              <h3 class="text-base font-black uppercase leading-tight line-clamp-2 text-white group-hover:text-cyan-400 transition-colors">${title}</h3>
            </div>
          </a>
        `;
      }).join('');

    } catch (e) {
      loadingState?.classList.add('hidden');
      emptyState?.classList.remove('hidden');
    }
  });
</script>