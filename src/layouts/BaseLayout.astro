---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalURL?: string | URL;
}

const { 
  title, 
  description = "AVARHQ is a custom-built digital mirror and expanded archive providing an unfiltered, highly-curated database of the anime industry's highest quality drops.",
  image = "/og-default.png", // Make sure to place a default image in your /public folder
  type = "website",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://avarhq.vercel.app')
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="bg-[#0a0c12] text-white antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link 
      rel="icon" 
      type="image/png" 
      href="/favicon-dark.png" 
      media="(prefers-color-scheme: light)" 
    />

   
    <link 
      rel="icon" 
      type="image/png" 
      href="/favicon-light.png" 
      media="(prefers-color-scheme: dark)" 
    />

    <!-- SVG Favicon: Dynamically adapts to Light/Dark OS & Browser theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Sets the tab/address bar to light grayish when user is in light mode -->
    <meta name="theme-color" content="#F5F5F5" media="(prefers-color-scheme: light)" />
    
    <!-- Sets the tab/address bar to dark charcoal when user is in dark mode -->
    <meta name="theme-color" content="#1A1A1A" media="(prefers-color-scheme: dark)" />
    
    <title>{title}</title>

<script is:inline>
    const introSeen = sessionStorage.getItem('avar-entry-seen') === '1';
    const ageVerified = localStorage.getItem('avar_age_verified') === 'true';
    if (introSeen) document.documentElement.classList.add('intro-skipped');
    if (ageVerified) document.documentElement.classList.add('age-verified');
  </script>

  <style>
    html.intro-skipped #avar-entry { display: none !important; }
    html.age-verified #age-gate { display: none !important; }
  </style>

  <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0c12" />

    <!-- Open Graph / Facebook / Discord -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>
  <body class="min-h-screen flex flex-col font-sans selection:bg-cyan-500 selection:text-black">
    <Header />
    
    <!-- <slot /> is where Astro injects your page content (index, blog, shop, etc) -->
    <main class="flex-grow max-w-7xl mx-auto w-full px-6 md:px-12 py-12">
      <slot /> 
    </main>
    
    <Footer />
   <!-- 18+ Age Gate Modal -->
    <div id="age-gate" class="fixed inset-0 w-screen h-screen z-[99999] flex items-center justify-center p-6 bg-[#0a0c12]/95 backdrop-blur-xl transition-opacity duration-500 opacity-0 pointer-events-none">
      <div class="max-w-md w-full bg-[#13151f] border border-white/10 rounded-2xl shadow-[0_0_50px_rgba(0,0,0,0.8)] p-8 text-center flex flex-col items-center">
        <div class="w-16 h-16 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center mb-6 text-red-500">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h2 class="text-2xl font-black uppercase tracking-tighter text-white mb-4">Content Advisory</h2>
        <p class="text-sm text-gray-400 leading-relaxed mb-8">
          Utmost care is taken to curate the contents of this website. However, if you are below the age of 18, you must leave this website immediately. 
        </p>
        <div class="flex flex-col w-full gap-3">
          <button id="btn-accept" type="button" class="w-full py-3.5 bg-white text-black font-black uppercase tracking-widest text-xs rounded-lg hover:bg-gray-200 transition-colors">
            I am 18 or older
          </button>
          <a href="https://www.google.com" class="w-full py-3.5 bg-transparent border border-white/10 text-gray-400 hover:text-white hover:bg-white/5 font-bold uppercase tracking-widest text-xs rounded-lg transition-colors">
            Leave Website
          </a>
        </div>
      </div>
    </div>

<script is:inline>
  function initAgeGate() {
    const ageGate = document.getElementById('age-gate');
    const acceptBtn = document.getElementById('btn-accept');
    
    if (!ageGate) return;

    // We expose this directly to the window so the Intro can never fail to find it
    window.triggerAvarAgeGate = function() {
      window.scrollTo(0, 0);
      document.body.style.overflow = 'hidden';
      ageGate.classList.remove('opacity-0', 'pointer-events-none');
      ageGate.classList.add('opacity-100', 'pointer-events-auto');
    };

    // Failsafe: If user bypassed intro (via refresh) but hasn't verified age, show it.
    if (sessionStorage.getItem('avar-entry-seen') === '1' && localStorage.getItem('avar_age_verified') !== 'true') {
      window.triggerAvarAgeGate();
    }

    if (acceptBtn) {
      // Refresh-proof button binding
      acceptBtn.onclick = function(e) {
        e.preventDefault();
        localStorage.setItem('avar_age_verified', 'true');
        
        // Fade out
        ageGate.classList.remove('opacity-100', 'pointer-events-auto');
        ageGate.classList.add('opacity-0', 'pointer-events-none');
        
        setTimeout(() => {
          ageGate.style.display = 'none';
          document.body.style.overflow = ''; // Unlocks inline style
          document.body.classList.remove('avar-entry-open'); // STRIPS THE CSS LOCK!
        }, 500); 
      };
    }
  }

  // Run instantly on load, and again on Astro navigation
  initAgeGate();
  document.addEventListener('astro:page-load', initAgeGate);
</script>
</body>
</html>